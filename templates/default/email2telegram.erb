#!/bin/bash

set -euo pipefail

message="$(cat | sed '1,/^$/d')" # delete headers (before first blank line)
token="<%= @token %>"
chat_id="<%= @chat_id %>"
url="https://api.telegram.org/bot${token}/sendMessage"

# Pass the URL (which holds the token) and the message through file descriptors rather than curl's arguments, which any
# local user can read in /proc/<pid>/cmdline. printf is a bash builtin, so it doesn't expose them either.
# Exit with EX_TEMPFAIL when Telegram doesn't take the message (--fail makes curl exit non-zero on HTTP errors), so that
# Postfix keeps it queued and retries instead of considering it delivered
curl -sS --fail --max-time 60 -X POST --config <(printf 'url = "%s"\n' "${url}") -d chat_id="${chat_id}" \
  --data-urlencode text@<(printf '%s' "${message::2048}") >/dev/null || exit 75
